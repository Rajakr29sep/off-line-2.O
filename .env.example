# ---- Node / Express ----
PORT=3000
# 0.0.0.0 = reachable from phones on the same Wi-Fi/hotspot. Use 127.0.0.1 for laptop-only.
HOST=0.0.0.0
PYTHON_API_URL=http://127.0.0.1:8000
SESSION_HOURS=12
FLOORPLAN_MAX_MB=15

# ---- Local AI (FastAPI + Ollama) — no cloud fallback ----
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_KEEP_ALIVE=30m
RAG_TOP_K=4
RAG_MAX_DISTANCE=0.45
ZIM_MAX_UPLOAD_MB=2048
ANONYMIZED_TELEMETRY=False
