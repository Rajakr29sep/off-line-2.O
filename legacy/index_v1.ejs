<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0b1220" />
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css" />
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar">
      <a class="brand" href="/">
        <span class="brand-mark"><i data-lucide="shield-check"></i></span>
        <span><strong>ResQ</strong><small>OFFLINE ASSISTANCE</small></span>
      </a>

      <div class="side-label">KNOWLEDGE BASE</div>
      <label class="field-label" for="topicSelect">Choose a topic</label>
      <select id="topicSelect" class="topic-select">
        <% topics.forEach((topic, index) => { %>
          <option value="<%= topic.label %>" data-file="<%= topic.file %>" <%= index === 0 ? "selected" : "" %>><%= topic.label %></option>
        <% }) %>
      </select>

      <div class="pdf-card">
        <div class="pdf-icon"><i data-lucide="file-text"></i></div>
        <div class="pdf-info">
          <span class="tiny-label">SELECTED DOCUMENT</span>
          <strong id="selectedFile"><%= topics[0].file %></strong>
          <span id="pdfStatus" class="status-line"><span class="status-dot"></span> Checking document…</span>
        </div>
      </div>

      <button class="btn btn-secondary full-width" id="indexButton">
        <i data-lucide="database"></i><span>Index / refresh PDF</span>
      </button>
      <p class="side-hint">First-time indexing may take a few minutes, especially for scanned PDFs.</p>

      <div class="sidebar-divider"></div>
      <div class="side-label">VOICE CONTROLS</div>
      <div class="setting-row">
        <div class="setting-copy"><strong>Speak responses</strong><small>Read answers aloud</small></div>
        <label class="switch"><input id="voiceToggle" type="checkbox" checked><span></span></label>
      </div>
      <div class="setting-row">
        <div class="setting-copy"><strong>Voice input</strong><small>Use your microphone</small></div>
        <label class="switch"><input id="voiceInputToggle" type="checkbox" checked><span></span></label>
      </div>

      <div class="sidebar-bottom">
        <div class="offline-indicator"><span class="pulse-dot"></span><span><strong>Local AI engine</strong><small>Ollama · ChromaDB · RAG</small></span></div>
        <button class="text-button" id="clearChat"><i data-lucide="rotate-ccw"></i> Clear conversation</button>
      </div>
    </aside>

    <main class="main-panel">
      <header class="topbar">
        <div class="breadcrumb"><span>Workspace</span><i data-lucide="chevron-right"></i><strong>Disaster assistant</strong></div>
        <div class="topbar-right"><span class="connection-pill" id="connectionStatus"><span class="status-dot"></span> Checking local service</span><span class="avatar">R</span></div>
      </header>

      <section class="content-wrap">
        <div class="hero">
          <div class="hero-copy">
            <div class="eyebrow"><span class="eyebrow-dot"></span> YOUR LOCAL EMERGENCY KNOWLEDGE HUB</div>
            <h1>Help when every<br><span>second matters.</span></h1>
            <p>Ask clear questions. Get practical guidance grounded in your selected disaster-response documents.</p>
            <div class="hero-actions">
              <button class="btn btn-primary" id="focusChat"><i data-lucide="message-circle"></i> Ask a question</button>
              <span class="hero-note"><i data-lucide="lock-keyhole"></i> Local document search &amp; local LLM</span>
            </div>
          </div>
          <div class="hero-art" aria-hidden="true">
            <canvas id="resq3dCanvas" class="resq-3d-canvas"></canvas>
            <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
            <div class="hero-emblem"><i data-lucide="shield-check"></i><span class="emblem-cross">+</span></div>
            <span class="float-chip chip-top"><i data-lucide="activity"></i> Prepared</span>
            <span class="float-chip chip-bottom"><i data-lucide="radio-tower"></i> Ready to help</span>
          </div>
        </div>

        <div class="stats-row">
          <div class="stat-card"><span class="stat-icon blue"><i data-lucide="book-open-check"></i></span><div><small>Knowledge topics</small><strong>06 <em>documents</em></strong></div></div>
          <div class="stat-card"><span class="stat-icon teal"><i data-lucide="brain-circuit"></i></span><div><small>Answer engine</small><strong>Local AI <em>Ollama</em></strong></div></div>
          <div class="stat-card"><span class="stat-icon violet"><i data-lucide="audio-lines"></i></span><div><small>Voice assistant</small><strong>Enabled <em>optional</em></strong></div></div>
        </div>

        <div class="workspace-heading">
          <div><div class="section-kicker">ASSISTANCE WORKSPACE</div><h2 id="topicHeading">General disaster safety</h2><p id="topicDescription">Preparedness, safety basics and practical guidance.</p></div>
          <span class="source-badge"><i data-lucide="file-check-2"></i> Source-grounded answers</span>
        </div>

        <div class="chat-panel">
          <div class="chat-header"><div class="chat-header-icon"><i data-lucide="messages-square"></i></div><div><strong>Emergency guidance assistant</strong><small>Ask about the selected document</small></div><span class="chat-live"><span class="status-dot"></span> READY</span></div>
          <div class="chat-messages" id="chatMessages">
            <div class="welcome-card" id="welcomeCard">
              <div class="welcome-icon"><i data-lucide="hand-heart"></i></div>
              <h3>How can I help you prepare?</h3>
              <p>Select a topic on the left and ask a question. Answers use your local PDF knowledge base.</p>
              <div class="suggestion-list">
                <button class="suggestion" data-question="What are the most important safety precautions?"><i data-lucide="shield-alert"></i><span>What are the most important safety precautions?</span><i data-lucide="arrow-up-right"></i></button>
                <button class="suggestion" data-question="What should I do first in an emergency?"><i data-lucide="list-check"></i><span>What should I do first in an emergency?</span><i data-lucide="arrow-up-right"></i></button>
                <button class="suggestion" data-question="Summarize the key guidance in this document."><i data-lucide="file-search"></i><span>Summarize this document</span><i data-lucide="arrow-up-right"></i></button>
              </div>
            </div>
          </div>
          <div class="composer-wrap">
            <form id="chatForm" class="composer">
              <textarea id="questionInput" rows="1" placeholder="Ask a question about this emergency topic…" aria-label="Your question"></textarea>
              <div class="composer-actions">
                <div class="composer-tools"><button type="button" class="icon-button" id="micButton" title="Record voice question"><i data-lucide="mic"></i></button><span class="composer-hint" id="voiceHint">Voice input available in supported browsers</span></div>
                <button class="btn btn-primary send-button" type="submit" id="sendButton"><span>Send question</span><i data-lucide="arrow-up"></i></button>
              </div>
            </form>
            <p class="disclaimer"><i data-lucide="info"></i> For immediate danger, contact local emergency services. This prototype is not a live dispatch or alert system.</p>
          </div>
        </div>
        <footer class="footer"><span>ResQ · Offline Disaster Assistance</span><span><i data-lucide="shield-check"></i> Designed for preparedness, not a substitute for responders</span></footer>
      </section>
    </main>
  </div>
  <div class="toast" id="toast" role="status"></div>
  <script>window.RESQ_TOPICS = <%- JSON.stringify(topics) %>;</script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r152/three.min.js"></script>
  <script src="/js/hero-3d.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>
