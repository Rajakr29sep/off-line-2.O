<%- include('../partials/head', { title }) %>
<%- include('../partials/shell-start', { title, page }) %>
<section class="hero">
  <div>
    <div class="kicker">Offline-first emergency platform</div>
    <h1>Prepare. Navigate. Respond.<br><span>Even offline.</span></h1>
    <p>Evacuation routes on real floor plans, two-way SOS over local Wi-Fi, offline maps and a local AI assistant — all running on this laptop. Internet is only needed for the one-time setup.</p>
    <div class="row wrap" style="margin-top:16px" id="heroActions"></div>
  </div>
  <div class="hero-canvas"><canvas id="heroCanvas" aria-hidden="true"></canvas></div>
</section>

<div class="panel">
  <div class="panel-head"><i data-lucide="activity"></i><h2>System status</h2><div class="spacer"></div><span class="dim" style="font-size:12px" id="statusTime">Checking…</span>
    <button class="btn sm ghost" id="refreshStatus"><i data-lucide="refresh-cw"></i></button></div>
  <div class="status-grid" id="statusGrid"></div>
  <p class="dim" style="font-size:12px;margin-top:10px">Every indicator is a live check. “Offline” internet is expected during the demo — the local features keep working. Phones still need the same local Wi-Fi/hotspot to reach this laptop.</p>
</div>

<div class="grid cols-3" id="modules"></div>
<%- include('../partials/shell-end') %>
