<%- include('../partials/head', { title }) %>
<%- include('../partials/shell-start', { title, page }) %>
<div class="grid side">
  <div class="panel stack">
    <div class="row between wrap">
      <div><div class="kicker">Offline AI assistant</div><h2>Ask the emergency knowledge pack</h2></div>
      <span class="pill" id="aiPill"><span class="dot"></span>Checking local AI…</span>
    </div>
    <div class="chat" id="chat">
      <div class="empty" id="welcome">Answers are generated by <strong>Llama 3.2 3B</strong> running locally through Ollama, using only passages retrieved from the loaded ZIM knowledge pack. Each answer lists the sources it used.</div>
    </div>
    <div class="chips" id="suggest">
      <button class="chip" data-q="What should I do during an earthquake?"><i data-lucide="activity"></i>Earthquake</button>
      <button class="chip" data-q="What should I do if a building catches fire?"><i data-lucide="flame"></i>Building fire</button>
      <button class="chip" data-q="What precautions should I take during a flood?"><i data-lucide="waves"></i>Flood precautions</button>
      <button class="chip" data-q="What are the basic first-aid steps for an injured person?"><i data-lucide="heart-pulse"></i>First aid</button>
    </div>
    <form class="composer" id="askForm">
      <button type="button" class="btn mic" id="micBtn" title="Ask by voice (local speech-to-text)"><i data-lucide="mic"></i></button>
      <textarea class="input" id="q" rows="1" maxlength="1000" placeholder="Type your question… (voice transcript appears here and can be edited)"></textarea>
      <button class="btn primary" id="sendBtn"><i data-lucide="send"></i></button>
    </form>
    <div class="row wrap between"><span class="dim" style="font-size:12px" id="voiceNote">Voice: checking…</span>
      <label class="row" style="gap:6px;font-size:12.5px"><input type="checkbox" id="speakToggle" checked /> Speak answers</label></div>
  </div>
  <div class="stack">
    <div class="panel">
      <div class="panel-head"><i data-lucide="cpu"></i><h2>Local AI stack</h2></div>
      <div class="list" id="stack"></div>
    </div>
    <div class="panel">
      <div class="panel-head"><i data-lucide="shield-alert"></i><h2>Grounding rules</h2></div>
      <ul class="muted" style="margin:0;padding-left:18px;font-size:13px;line-height:1.7">
        <li>Answers use only retrieved passages from the loaded pack.</li>
        <li>Citations are checked — numbers that don't match a retrieved passage are removed.</li>
        <li>Weak retrieval returns “Not found in the loaded knowledge pack”.</li>
        <li>No cloud AI is ever used. If Ollama is down you get an error, or a clearly labelled cached answer.</li>
      </ul>
    </div>
  </div>
</div>
<%- include('../partials/shell-end') %>
<script src="/js/assistant.js"></script>
</body></html>
