<body data-page="<%= page %>">
<div class="shell">
  <aside class="sidebar" id="sidebar">
    <a class="brand" href="/"><span class="brand-mark"><i data-lucide="shield-plus"></i></span>
      <span><strong>OfflineAid</strong><small>PREPARE · NAVIGATE · RESPOND</small></span></a>
    <nav class="nav" id="nav">
      <a href="/" data-page="overview" data-roles="*"><i data-lucide="layout-dashboard"></i>Overview</a>
      <div class="nav-label" data-roles="officer,administrator,employee">ORGANISATION</div>
      <a href="/organisation" data-page="organisation" data-roles="officer,administrator"><i data-lucide="building-2"></i>Organisation</a>
      <a href="/saferoute" data-page="saferoute" data-roles="officer,administrator,employee"><i data-lucide="route"></i>SafeRoute</a>
      <a href="/connect" data-page="connect" data-roles="officer,administrator,employee,citizen"><i data-lucide="radio-tower"></i>Connect<span class="pill danger hidden" id="navSosCount" style="margin-left:auto;padding:0 7px">0</span></a>
      <div class="nav-label" data-roles="*">ASSIST</div>
      <a href="/assistant" data-page="assistant" data-roles="*"><i data-lucide="bot"></i>AI Assistant</a>
      <a href="/map" data-page="map" data-roles="*"><i data-lucide="map"></i>Offline Map</a>
      <a href="/government" data-page="government" data-roles="government_operator"><i data-lucide="landmark"></i>Government</a>
      <div class="nav-label" data-roles="*">SYSTEM</div>
      <a href="/knowledge" data-page="knowledge" data-roles="administrator,officer,government_operator"><i data-lucide="library"></i>Knowledge Sources</a>
      <a href="/settings" data-page="settings" data-roles="*"><i data-lucide="settings"></i>Settings</a>
    </nav>
    <div class="sidebar-foot"><div class="row"><span class="pill" id="wsPill"><span class="dot"></span>Connecting…</span></div>
      <div style="margin-top:8px" id="footNet">Local network mode</div></div>
  </aside>
  <div class="main">
    <header class="topbar">
      <button class="btn ghost sm menu-btn" id="menuBtn" aria-label="Menu"><i data-lucide="menu"></i></button>
      <h1><%= title %></h1>
      <span class="pill hidden" id="orgStatusPill"></span>
      <div class="spacer"></div>
      <span class="pill" id="netPill" title="Internet connectivity of this device"><span class="dot"></span>…</span>
      <span class="pill hidden" id="outboxPill" title="Messages waiting in this device's offline queue"><i data-lucide="inbox"></i><span>0 queued</span></span>
      <div class="user-chip" id="userChip"><span class="avatar" id="userAvatar">?</span><span class="who"><strong id="userName">…</strong><small id="userRole"></small></span>
        <button class="btn ghost sm" id="logoutBtn" title="Sign out"><i data-lucide="log-out"></i></button></div>
    </header>
    <main class="content" id="content">
